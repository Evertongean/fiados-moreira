{
  "expo": {
    "name": "Fiados Moreira",
    "slug": "fiados-moreira",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "fiadosmoreira",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false

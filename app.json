{
  "expo": {
    "name": "Fiados Moreira",
    "slug": "fiados-moreira",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "fiadosmoreira",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8FAFC",
          "dark": {
            "backgroundColor": "#101714"
          }
        }
      ],
      "expo-sqlite",
      "expo-notifications",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}

# URL pública do projeto Supabase (Connect → Project URL)
EXPO_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave publicável para aplicativos cliente (sb_publishable_...)
# Nunca use sb_secret_..., service_role ou credenciais do PostgreSQL no aplicativo.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_substitua_aqui
